        },
        {
          "type": "text",
          "id": "review_count",
          "label": "Review count",
          "default": "40"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review text",
          "default": "\"This is exactly what was described and what I was looking for...it washed and dried very well. My husband loves it!\""
