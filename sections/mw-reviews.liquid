{% comment %}
  MW Reviews - Figma Desktop / Slice / Option 2 (1186x297)
  Customer reviews with product images and navigation arrows
{% endcomment %}

<mw-reviews-carousel class="mw-reviews">
  <div class="mw-reviews__container">
    {% if section.settings.heading != blank %}
      <h2 class="mw-reviews__heading mw-heading mw-heading--sm">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    <div class="mw-reviews__carousel-wrap">
      <button class="mw-reviews__arrow mw-reviews__arrow--prev" aria-label="Previous review" type="button">
        <img src="{{ 'caret-down-3.svg' | asset_url }}" alt="" width="13" height="24" aria-hidden="true" style="transform: rotate(90deg);">
      </button>

      <div class="mw-reviews__carousel">
        <div class="mw-reviews__track">
          {% for block in section.blocks %}
            {% if block.type == 'review' %}
              <div class="mw-reviews__card" {{ block.shopify_attributes }}>
                {% if block.settings.product_image != blank %}
                  <div class="mw-reviews__product-image">
                    {{
                      block.settings.product_image
                      | image_url: width: block.settings.product_image.width
                      | image_tag:
                        sizes: '(min-width: 750px) 162px, 132px',
                        widths: '132,162,264,324',
                        loading: 'lazy',
                        class: 'mw-reviews__product-img',
                        alt: block.settings.product_name
                    }}
                  </div>
                {% endif %}

                <div class="mw-reviews__content">
                  <div class="mw-reviews__product-info">
                    <div class="mw-reviews__rating">
                      <img src="{{ '4-stars-and-up.svg' | asset_url }}" alt="Rating" width="82" height="14" loading="lazy">
                      {% if block.settings.review_count != blank %}
                        <span class="mw-reviews__rating-count">{{ block.settings.review_count | escape }}</span>
                      {% endif %}
                    </div>
                    {% if block.settings.product_name != blank %}
                      <h3 class="mw-reviews__product-name">{{ block.settings.product_name | escape }}</h3>
                    {% endif %}
                  </div>

                  <div class="mw-reviews__review-body">
                    {% if block.settings.review_text != blank %}
                      <blockquote class="mw-reviews__quote">
                        {{ block.settings.review_text | escape }}
                      </blockquote>
                    {% endif %}
                    {% if block.settings.reviewer_name != blank %}
                      <cite class="mw-reviews__reviewer">{{ block.settings.reviewer_name | escape }}</cite>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <button class="mw-reviews__arrow mw-reviews__arrow--next" aria-label="Next review" type="button">
        <img src="{{ 'caret-down-3.svg' | asset_url }}" alt="" width="13" height="24" aria-hidden="true" style="transform: rotate(-90deg);">
      </button>
    </div>
  </div>
</mw-reviews-carousel>

{% javascript %}
class MwReviewsCarousel extends HTMLElement {
  connectedCallback() {
    this.track = this.querySelector('.mw-reviews__track');
    this.prevBtn = this.querySelector('.mw-reviews__arrow--prev');
    this.nextBtn = this.querySelector('.mw-reviews__arrow--next');

    if (this.prevBtn) {
      this.prevBtn.addEventListener('click', () => this.scroll(-1));
    }
    if (this.nextBtn) {
      this.nextBtn.addEventListener('click', () => this.scroll(1));
    }
  }

  scroll(direction) {
    if (!this.track) return;
    const card = this.track.querySelector('.mw-reviews__card');
    if (!card) return;
    const scrollAmount = card.offsetWidth + 24;
    this.track.scrollBy({ left: scrollAmount * direction, behavior: 'smooth' });
  }
}

customElements.define('mw-reviews-carousel', MwReviewsCarousel);
{% endjavascript %}

{% stylesheet %}
.mw-reviews {
  padding-block: 48px;
}

.mw-reviews__container {
  max-width: 1186px;
  margin-inline: auto;
  padding-inline: 16px;
}

.mw-reviews__heading {
  margin: 0 0 24px;
}

.mw-reviews__carousel-wrap {
  display: flex;
  align-items: center;
  gap: 16px;
}

.mw-reviews__arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  flex-shrink: 0;
  min-width: 44px;
  min-height: 44px;
}

.mw-reviews__arrow--prev img {
  opacity: 1;
}

.mw-reviews__arrow--next img {
  opacity: 0.4;
}

.mw-reviews__carousel {
  flex: 1;
  overflow: hidden;
}

.mw-reviews__track {
  display: flex;
  gap: 24px;
  overflow-x: auto;
  scrollbar-width: none;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
}

.mw-reviews__track::-webkit-scrollbar {
  display: none;
}

.mw-reviews__card {
  display: flex;
  gap: 16px;
  flex: 0 0 calc(50% - 12px);
  scroll-snap-align: start;
}

.mw-reviews__product-image {
  flex-shrink: 0;
  width: 162px;
  height: 232px;
}

.mw-reviews__product-img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.mw-reviews__content {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.mw-reviews__product-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.mw-reviews__rating {
  display: flex;
  align-items: center;
  gap: 8px;
}

.mw-reviews__rating-count {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 12px;
  line-height: 16px;
  color: #6A6A6A;
}

.mw-reviews__product-name {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 18px;
  line-height: 23px;
  color: #001237;
  margin: 0;
}

.mw-reviews__review-body {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.mw-reviews__quote {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 20px;
  line-height: 25px;
  color: #001237;
  margin: 0;
  padding: 0;
  border: none;
}

.mw-reviews__reviewer {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 18px;
  line-height: 23px;
  color: #001237;
  font-style: normal;
}

@media screen and (max-width: 749px) {
  .mw-reviews {
    padding-block: 32px;
  }

  .mw-reviews__heading {
    font-size: 24px;
    line-height: 28px;
    letter-spacing: 0.12px;
  }

  .mw-reviews__card {
    flex: 0 0 100%;
  }

  .mw-reviews__product-image {
    width: 132px;
    height: 189px;
  }

  .mw-reviews__quote {
    font-size: 16px;
    line-height: 21px;
  }

  .mw-reviews__product-name {
    font-size: 12px;
    line-height: 17px;
  }

  .mw-reviews__reviewer {
    font-size: 14px;
    line-height: 19px;
  }

  .mw-reviews__arrow {
    min-width: 32px;
    min-height: 32px;
    padding: 4px;
  }

  .mw-reviews__arrow img {
    width: 11px;
    height: 19px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.mw_reviews",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "what people say"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product image"
        },
        {
          "type": "text",
