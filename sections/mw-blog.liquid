{% comment %}
  MW Blog - Figma Desktop / Slice / Blog 3 (1312x456)
  Blog articles grid with title, date, and image
{% endcomment %}

<section class="mw-blog">
  <div class="mw-blog__container">
    <div class="mw-blog__header">
      {% if section.settings.heading != blank %}
        <h2 class="mw-blog__heading mw-heading mw-heading--sm">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}
      {% if section.settings.view_all_text != blank %}
        <a href="{{ section.settings.view_all_url | default: '/blogs/news' }}" class="mw-blog__view-all">
          {{ section.settings.view_all_text | escape }}
        </a>
      {% endif %}
    </div>

    <div class="mw-blog__articles">
      {%- assign blog_handle = section.settings.blog -%}
      {%- assign article_count = section.settings.article_count | default: 3 -%}

      {% if blogs[blog_handle] != blank %}
        {%- for article in blogs[blog_handle].articles limit: article_count -%}
          <article class="mw-blog__article">
            {% if article.image != blank %}
              <a href="{{ article.url }}" class="mw-blog__article-image-link">
                {{
                  article.image
                  | image_url: width: article.image.width
                  | image_tag:
                    sizes: '(min-width: 750px) 416px, 280px',
                    widths: '280,416,560,832',
                    loading: 'lazy',
                    class: 'mw-blog__article-img',
                    alt: article.title
                }}
              </a>
            {% endif %}
            <div class="mw-blog__article-content">
              <h3 class="mw-blog__article-title">
                <a href="{{ article.url }}">{{ article.title | escape }}</a>
              </h3>
              <time class="mw-blog__article-date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                {{ article.published_at | date: '%B %d, %Y' }}
              </time>
            </div>
          </article>
        {%- endfor -%}
      {% else %}
        {%- comment -%} Placeholder articles when no blog is selected {%- endcomment -%}
        {% for i in (1..3) %}
          <article class="mw-blog__article">
            <div class="mw-blog__article-image-link">
              <div class="mw-blog__article-placeholder"></div>
            </div>
            <div class="mw-blog__article-content">
              <h3 class="mw-blog__article-title">
                <a href="#">Blog Article Name</a>
              </h3>
              <time class="mw-blog__article-date">One liner description or date.</time>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
.mw-blog {
  padding-block: 48px;
}

.mw-blog__container {
  max-width: 1312px;
  margin-inline: auto;
  padding-inline: 16px;
}

.mw-blog__header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-block-end: 24px;
}

.mw-blog__heading {
  margin: 0;
}

.mw-blog__view-all {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 18px;
  line-height: 23px;
  color: #001237;
  text-decoration: underline;
}

.mw-blog__articles {
  display: flex;
  gap: 24px;
}

.mw-blog__article {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.mw-blog__article-image-link {
  display: block;
  text-decoration: none;
}

.mw-blog__article-img {
  display: block;
  width: 100%;
  aspect-ratio: 416 / 278;
  object-fit: cover;
}

.mw-blog__article-placeholder {
  width: 100%;
  aspect-ratio: 416 / 278;
  background: #F7F7F7;
}

.mw-blog__article-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.mw-blog__article-title {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 18px;
  line-height: 23px;
  color: #001237;
  margin: 0;
  text-transform: capitalize;
}

.mw-blog__article-title a {
  color: inherit;
  text-decoration: none;
}

.mw-blog__article-date {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 14px;
  line-height: 19px;
  color: #001237;
}

@media screen and (max-width: 749px) {
  .mw-blog {
    padding-block: 32px;
  }

  .mw-blog__heading {
    font-size: 24px;
    line-height: 28px;
    letter-spacing: 0.12px;
  }

  .mw-blog__view-all {
    font-size: 14px;
    line-height: 19px;
  }

  .mw-blog__articles {
    overflow-x: auto;
    scrollbar-width: none;
    gap: 16px;
    -webkit-overflow-scrolling: touch;
  }

  .mw-blog__articles::-webkit-scrollbar {
    display: none;
  }

  .mw-blog__article {
    flex: 0 0 280px;
  }

  .mw-blog__article-img {
    aspect-ratio: 280 / 187;
  }

  .mw-blog__article-placeholder {
    aspect-ratio: 280 / 187;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.mw_blog",
  "tag": "div",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "number",
      "id": "article_count",
      "label": "Articles to show",
      "default": 3
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mack Weldon Blog"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "View All Articles"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all URL"
    }
  ],
  "presets": [
    {
      "name": "t:names.mw_blog"
    }
  ]
}
{% endschema %}
