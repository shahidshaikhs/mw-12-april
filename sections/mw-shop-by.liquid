{% comment %}
  MW Shop By - Figma Desktop / Slice / Tabbed Carousel (1440x392)
  Title + tabs + scrollable category cards
{% endcomment %}

<mw-shop-by-tabs class="mw-shop-by">
  <div class="mw-shop-by__container">
    {% if section.settings.heading != blank %}
      <h2 class="mw-shop-by__heading mw-heading mw-heading--sm">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    {%- comment -%} Tabs {%- endcomment -%}
    <div class="mw-shop-by__tabs" role="tablist" aria-label="Category tabs">
      {% for block in section.blocks %}
        {% if block.type == 'tab' %}
          <button
            class="mw-shop-by__tab{% if forloop.first %} mw-shop-by__tab--active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="mw-tab-panel-{{ block.id }}"
            id="mw-tab-{{ block.id }}"
            type="button"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.tab_name | escape }}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    {%- comment -%} Tab Panels {%- endcomment -%}
    {% for block in section.blocks %}
      {% if block.type == 'tab' %}
        <div
          class="mw-shop-by__panel{% if forloop.first %} mw-shop-by__panel--active{% endif %}"
          role="tabpanel"
          id="mw-tab-panel-{{ block.id }}"
          aria-labelledby="mw-tab-{{ block.id }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          <div class="mw-shop-by__cards">
            {% for i in (1..5) %}
              {%- assign img_key = 'category_image_' | append: i -%}
              {%- assign label_key = 'category_label_' | append: i -%}
              {%- assign url_key = 'category_url_' | append: i -%}
              {%- assign img = block.settings[img_key] -%}
              {%- assign label = block.settings[label_key] -%}
              {%- assign url = block.settings[url_key] -%}
              {% if label != blank %}
                <a href="{{ url }}" class="mw-shop-by__card">
                  <div class="mw-shop-by__card-image">
                    {% if img != blank %}
                      {{
                        img
                        | image_url: width: img.width
                        | image_tag:
                          sizes: '(min-width: 750px) 208px, 124px',
                          widths: '124,208,250,416',
                          loading: 'lazy',
                          class: 'mw-shop-by__card-img',
                          alt: label
                      }}
                    {% else %}
                      <div class="mw-shop-by__card-placeholder"></div>
                    {% endif %}
                  </div>
                  <span class="mw-shop-by__card-label">{{ label | escape }}</span>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</mw-shop-by-tabs>

{% javascript %}
class MwShopByTabs extends HTMLElement {
  connectedCallback() {
    const tabs = this.querySelectorAll('[role="tab"]');
    for (const tab of tabs) {
      tab.addEventListener('click', () => this.switchTab(tab));
    }
  }

  switchTab(selectedTab) {
    const tabs = this.querySelectorAll('[role="tab"]');
    const panels = this.querySelectorAll('[role="tabpanel"]');

    for (const tab of tabs) {
      tab.classList.remove('mw-shop-by__tab--active');
      tab.setAttribute('aria-selected', 'false');
    }

    for (const panel of panels) {
      panel.classList.remove('mw-shop-by__panel--active');
      panel.hidden = true;
    }

    selectedTab.classList.add('mw-shop-by__tab--active');
    selectedTab.setAttribute('aria-selected', 'true');

    const panelId = selectedTab.getAttribute('aria-controls');
    const panel = document.getElementById(panelId);
    if (panel) {
      panel.classList.add('mw-shop-by__panel--active');
      panel.hidden = false;
    }
  }
}

customElements.define('mw-shop-by-tabs', MwShopByTabs);
{% endjavascript %}

{% stylesheet %}
.mw-shop-by {
  padding-block: 48px;
  background: #FFFFFF;
}

.mw-shop-by__container {
  max-width: 1440px;
  margin-inline: auto;
  padding-inline: 56px;
}

.mw-shop-by__heading {
  margin: 0 0 16px;
}

.mw-shop-by__tabs {
  display: flex;
  gap: 24px;
  align-items: center;
  margin-block-end: 24px;
}

.mw-shop-by__tab {
  background: none;
  border: none;
  cursor: pointer;
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 18px;
  line-height: 23px;
  color: #001237;
  padding: 0;
}

.mw-shop-by__tab--active {
  font-weight: 500;
}

.mw-shop-by__panel {
  display: none;
}

.mw-shop-by__panel--active {
  display: block;
}

.mw-shop-by__cards {
  display: flex;
  gap: 24px;
  overflow-x: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

.mw-shop-by__cards::-webkit-scrollbar {
  display: none;
}

.mw-shop-by__card {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 0 0 208px;
  text-decoration: none;
}

.mw-shop-by__card-image {
  width: 208px;
  height: 312px;
  overflow: hidden;
}

.mw-shop-by__card-img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.mw-shop-by__card-placeholder {
  width: 100%;
  height: 100%;
  background: #F7F7F7;
}

.mw-shop-by__card-label {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 20px;
  line-height: 25px;
  color: #001237;
  text-transform: capitalize;
}

@media screen and (max-width: 749px) {
  .mw-shop-by {
    padding-block: 32px;
  }

  .mw-shop-by__container {
    padding-inline: 16px;
  }

  .mw-shop-by__heading {
    text-align: center;
    font-size: 24px;
    line-height: 28px;
    letter-spacing: 0.12px;
  }

  .mw-shop-by__tabs {
    justify-content: center;
    gap: 16px;
  }

  .mw-shop-by__tab {
    font-size: 14px;
    line-height: 19px;
  }

  .mw-shop-by__card {
    flex: 0 0 124px;
  }

  .mw-shop-by__card-image {
    width: 124px;
    height: 186px;
  }

  .mw-shop-by__card-label {
    font-size: 16px;
    line-height: 21px;
  }
}
{% endstylesheet %}

