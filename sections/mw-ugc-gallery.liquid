{% comment %}
  MW UGC Gallery - Figma Desktop / Slice / UGC (1312x335)
  Instagram-style gallery with shoppable tags
{% endcomment %}

<section class="mw-ugc">
  <div class="mw-ugc__container">
    <div class="mw-ugc__header">
      {% if section.settings.heading != blank %}
        <h2 class="mw-ugc__heading mw-heading mw-heading--sm">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}
      {% if section.settings.instagram_handle != blank %}
        <a href="{{ section.settings.instagram_url }}" class="mw-ugc__handle" target="_blank" rel="noopener">
          {{ section.settings.instagram_handle | escape }}
        </a>
      {% endif %}
    </div>

    <div class="mw-ugc__carousel">
      <div class="mw-ugc__track">
        {% for block in section.blocks %}
          {% if block.type == 'ugc-image' %}
            <div class="mw-ugc__item" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    sizes: '(min-width: 750px) 256px, 196px',
                    widths: '196,256,392,512',
                    loading: 'lazy',
                    class: 'mw-ugc__img',
                    alt: block.settings.image.alt
                }}
              {% else %}
                <div class="mw-ugc__placeholder"></div>
              {% endif %}

              {%- comment -%} Tag button {%- endcomment -%}
              <div class="mw-ugc__tag-btn">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                  <circle cx="9" cy="9" r="9" fill="#FFFFFF"/>
                  <path d="M6 7L10 9L6 11" fill="none" stroke="#001237" stroke-width="1"/>
                </svg>
              </div>

              {%- comment -%} Product overlay {%- endcomment -%}
              {% if block.settings.product_1_title != blank %}
                <div class="mw-ugc__overlay">
                  <a href="{{ block.settings.product_1_url }}" class="mw-ugc__product-link">
                    {{ block.settings.product_1_title | escape }}
                  </a>
                  {% if block.settings.product_2_title != blank %}
                    <a href="{{ block.settings.product_2_url }}" class="mw-ugc__product-link">
                      {{ block.settings.product_2_title | escape }}
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.mw-ugc {
  padding-block: 48px;
}

.mw-ugc__container {
  max-width: 1312px;
  margin-inline: auto;
  padding-inline: 16px;
}

.mw-ugc__header {
  display: flex;
  align-items: baseline;
  gap: 16px;
  margin-block-end: 24px;
}

.mw-ugc__heading {
  margin: 0;
}

.mw-ugc__handle {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 18px;
  line-height: 23px;
  color: #001237;
  text-decoration: underline;
}

.mw-ugc__carousel {
  overflow: hidden;
}

.mw-ugc__track {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

.mw-ugc__track::-webkit-scrollbar {
  display: none;
}

.mw-ugc__item {
  position: relative;
  flex: 0 0 256px;
  width: 256px;
  height: 256px;
  overflow: hidden;
}

.mw-ugc__img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.mw-ugc__placeholder {
  width: 100%;
  height: 100%;
  background: #F7F7F7;
}

.mw-ugc__tag-btn {
  position: absolute;
  bottom: 8px;
  right: 8px;
  cursor: pointer;
  z-index: 2;
}

.mw-ugc__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  z-index: 1;
}

.mw-ugc__item:hover .mw-ugc__overlay {
  display: flex;
}

.mw-ugc__product-link {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 14px;
  line-height: 19px;
  color: #FFFFFF;
  text-decoration: underline;
  text-align: center;
}

@media screen and (max-width: 749px) {
  .mw-ugc {
    padding-block: 32px;
  }

  .mw-ugc__heading {
    font-size: 24px;
    line-height: 28px;
    letter-spacing: 0.12px;
  }

  .mw-ugc__item {
    flex: 0 0 196px;
    width: 196px;
    height: 196px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.mw_ugc_gallery",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "#wearitwell"
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Instagram handle",
      "default": "@MackWeldon"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    }
  ],
  "blocks": [
    {
      "type": "ugc-image",
      "name": "Image",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "product_1_title",
          "label": "Product 1 name"
        },
        {
          "type": "url",
          "id": "product_1_url",
          "label": "Product 1 URL"
        },
        {
          "type": "text",
          "id": "product_2_title",
          "label": "Product 2 name"
        },
        {
          "type": "url",
          "id": "product_2_url",
          "label": "Product 2 URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.mw_ugc_gallery",
      "blocks": [
        { "type": "ugc-image", "settings": { "product_1_title": "SILVER Polo" } },
        { "type": "ugc-image", "settings": { "product_1_title": "SILVER Polo" } },
        { "type": "ugc-image", "settings": { "product_1_title": "Mavrick Tech Chino" } },
        { "type": "ugc-image" },
        { "type": "ugc-image" }
      ]
    }
  ]
}
{% endschema %}
