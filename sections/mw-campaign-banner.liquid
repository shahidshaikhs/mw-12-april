{% comment %}
  MW Campaign Banner - Figma Desktop / Campaign / Landscape (1128x634)
  Full background image with bottom-right aligned text and CTA buttons
{% endcomment %}

<section class="mw-campaign">
  <div class="mw-campaign__container">
    <div class="mw-campaign__inner">
      {% if section.settings.background_image != blank %}
        {{
          section.settings.background_image
          | image_url: width: section.settings.background_image.width
          | image_tag:
            sizes: '(min-width: 750px) 1128px, 100vw',
            widths: '375,750,1128,1500',
            loading: 'lazy',
            class: 'mw-campaign__bg-img',
            alt: section.settings.background_image.alt
        }}
      {% else %}
        <div class="mw-campaign__bg-placeholder"></div>
      {% endif %}

      <div class="mw-campaign__content">
        <div class="mw-campaign__text">
          {% if section.settings.heading != blank %}
            <h2 class="mw-campaign__heading mw-heading mw-heading--lg" style="color: #FFFFFF;">
              {{ section.settings.heading | escape }}
            </h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="mw-campaign__subheading">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        <div class="mw-campaign__buttons">
          {% if section.settings.button_1_text != blank %}
            <a href="{{ section.settings.button_1_url }}" class="mw-btn mw-btn--blur">
              {{ section.settings.button_1_text | escape }}
            </a>
          {% endif %}
          {% if section.settings.button_2_text != blank %}
            <a href="{{ section.settings.button_2_url }}" class="mw-btn mw-btn--blur">
              {{ section.settings.button_2_text | escape }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.mw-campaign {
  padding-block: 48px;
}

.mw-campaign__container {
  max-width: 1128px;
  margin-inline: auto;
  padding-inline: 16px;
}

.mw-campaign__inner {
  position: relative;
  width: 100%;
  aspect-ratio: 1128 / 634;
  overflow: hidden;
}

.mw-campaign__bg-img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.mw-campaign__bg-placeholder {
  width: 100%;
  height: 100%;
  background: #333333;
}

.mw-campaign__content {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: flex-end;
  padding: 48px;
  gap: 24px;
}

.mw-campaign__text {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0;
}

.mw-campaign__heading {
  margin: 0;
  text-align: end;
}

.mw-campaign__subheading {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 20px;
  line-height: 25px;
  color: #FFFFFF;
  margin: 0;
  text-align: end;
}

.mw-campaign__buttons {
  display: flex;
  gap: 12px;
}

@media screen and (max-width: 749px) {
  .mw-campaign {
    padding-block: 32px;
  }

  .mw-campaign__inner {
    aspect-ratio: 375 / 500;
  }

  .mw-campaign__content {
    padding: 24px 16px;
    align-items: center;
    justify-content: flex-end;
  }

  .mw-campaign__text {
    align-items: center;
  }

  .mw-campaign__heading {
    text-align: center;
    font-size: 36px;
    line-height: 40px;
    letter-spacing: 0.18px;
  }

  .mw-campaign__subheading {
    text-align: center;
    font-size: 16px;
    line-height: 21px;
  }

  .mw-campaign__buttons {
    flex-direction: column;
    width: 100%;
  }

  .mw-campaign__buttons .mw-btn {
    width: 100%;
    padding-inline: 24px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.mw_campaign_banner",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "pants campaign"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Lorem ipsum dolor sit amet, consectetur ."
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Button 1 text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_1_url",
      "label": "Button 1 URL"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Button 2 text",
      "default": "CTA"
    },
    {
      "type": "url",
      "id": "button_2_url",
      "label": "Button 2 URL"
    }
  ],
  "presets": [
    {
      "name": "t:names.mw_campaign_banner"
    }
  ]
}
{% endschema %}
